# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (sem barra no final). Em produção: https://seudominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Página que a raiz do domínio mostra: "captura" (antes do lançamento) ou "ventas" (vendas abertas).
# No dia do lançamento troque para ventas e faça um Redeploy.
PAGINA_INICIAL=captura
# Link do grupo de WhatsApp da lista de espera (já vem com o grupo atual; só preencha para trocar)
NEXT_PUBLIC_WHATSAPP_GROUP_URL=

# Marca e links do menu lateral da área de membros (os dois últimos são opcionais)
NEXT_PUBLIC_BRAND_NAME="Barbería Aaron"
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Hotmart (checkout). Un link por oferta (en la Hotmart: Producto > Ofertas > copiar link de pago).
NEXT_PUBLIC_HOTMART_URL_PROMO=
NEXT_PUBLIC_HOTMART_URL_VITALICIO=
NEXT_PUBLIC_HOTMART_URL_ANUAL=
# Código de cada oferta (aparece en la lista de ofertas de la Hotmart); el webhook lo usa para saber qué compró la persona.
HOTMART_OFFER_PROMO=
HOTMART_OFFER_VITALICIO=
HOTMART_OFFER_ANUAL=
# Hottok: Herramientas > Webhook > pestaña Autenticación. El webhook apunta a https://TU-DOMINIO/api/hotmart/webhook
HOTMART_HOTTOK=

# (Antiguo) PayPal, ya no se usa en la página de ventas (developer.paypal.com > Apps & Credentials). Use sandbox para testar.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# ID do webhook criado apontando para https://seudominio.com/api/paypal/webhook
PAYPAL_WEBHOOK_ID=
# IDs dos planos de assinatura criados no PayPal (mensal e anual)
PAYPAL_PLAN_ID_MONTHLY=
PAYPAL_PLAN_ID_ANNUAL=
NEXT_PUBLIC_PAYPAL_PLAN_ID_MONTHLY=
NEXT_PUBLIC_PAYPAL_PLAN_ID_ANNUAL=

# E-mail transacional (resend.com). EMAIL_FROM precisa ser de um domínio verificado.
RESEND_API_KEY=
EMAIL_FROM="Curso Aaron <acceso@seudominio.com>"
# Remetente dos e-mails de marketing (carrinho abandonado). Ideal: subdomínio separado,
# assim um problema nos disparos não afeta o e-mail de confirmação de compra.
EMAIL_FROM_MARKETING="Curso Aaron <hola@mail.seudominio.com>"

# Segredo do agendador (GitHub Actions) que dispara os e-mails de abandono. Gere um valor longo e aleatório.
CRON_SECRET=
# Opcional: prazo mostrado no último e-mail da sequência (ex.: "hasta el 30 de noviembre"). Vazio = sem prazo.
OFERTA_FIN=
HOTMART_TEST_EMAILS=
